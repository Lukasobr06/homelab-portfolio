# /etc/pve/lxc/<ID>.conf – unprivilegierter LXC-Container mit Docker
# Alle Werte sind Platzhalter.

arch: amd64
ostype: debian
hostname: <HOSTNAME>
unprivileged: 1
# nesting und keyctl werden für Docker im Container benötigt
features: nesting=1,keyctl=1
cores: 2
memory: 2048
swap: 512
rootfs: local-lvm:vm-<ID>-disk-0,size=8G
# Zwei Netzwerkkarten: Heimnetz und internes Segment
net0: name=eth0,bridge=vmbr0,firewall=1,hwaddr=XX:XX:XX:XX:XX:XX,ip=dhcp,type=veth
net1: name=eth1,bridge=vmbr1,hwaddr=XX:XX:XX:XX:XX:XX,ip=dhcp,type=veth
onboot: 1
